{
  "entities": {
    "users": {
      "title": "Portal Users",
      "description": "User profiles and credentials for DNO, operators, and staff",
      "fields": {
        "username": { "type": "string", "description": "Login username" },
        "password": { "type": "string", "description": "Login password" },
        "fullName": { "type": "string", "description": "Full name of the user" },
        "designation": { "type": "string", "description": "Official designation" },
        "role": { "type": "string", "description": "User role: dno, operator, counsellor, custom" },
        "allowedTabs": { "type": "array", "description": "Accessible navigation tabs" },
        "allowedFeatures": { "type": "array", "description": "Authorized features" },
        "isActive": { "type": "boolean", "description": "Account active flag" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "lastLogin": { "type": "string", "description": "Last login timestamp" },
        "phone": { "type": "string", "description": "Phone number" },
        "email": { "type": "string", "description": "Email address" },
        "profilePicture": { "type": "string", "description": "Profile picture URL" }
      }
    },
    "students": {
      "title": "Students Directory",
      "description": "Candidate registration and scrutiny records",
      "fields": {
        "applicationId": { "type": "string", "description": "Application ID" },
        "candidateName": { "type": "string", "description": "Full candidate name" },
        "course": { "type": "string", "description": "Course applied for" },
        "scrutinyStatus": { "type": "string", "description": "Scrutiny status" }
      }
    },
    "visitors": {
      "title": "Visitors Entry Register",
      "description": "Visitors entry register and check-in records",
      "fields": {
        "visitorName": { "type": "string", "description": "Visitor full name" },
